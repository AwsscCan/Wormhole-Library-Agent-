# 核心运行配置 —— 复制为 .env.local（已 gitignore，不会进仓库）后填值
DATABASE_URL="file:./dev.db"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-an-independent-random-secret"
AUTH_SECRET="replace-with-a-different-random-secret"
WRITING_CONFIG_ENCRYPTION_KEY="replace-with-an-independent-32-byte-key"

# LLM 配置示例
#
# 云端 API（OpenAI 兼容协议，任选一家）：
# 推荐 Anthropic Claude（via openai-next 聚合，国内直连）
#   LLM_BASE_URL=https://api.openai-next.com/v1   LLM_MODEL=claude-opus-4-7
# DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai-next.com/v1
LLM_MODEL=claude-opus-4-7

# Ollama 本地模型（云端不可用时的兜底，需本机已 pull 模型）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:7b

# 调试开关：置 1 强制走确定性拼接（不调任何模型）
# LLM_DISABLED=1
