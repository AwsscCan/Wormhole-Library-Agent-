{
  "name": "wormhole-library-agent",
  "version": "0.1.1",
  "private": true,
  "productName": "Wormhole Library Agent",
  "description": "A recoverable research workspace for federated search, knowledge maps, memory, and evidence-bound writing.",
  "author": "Wormhole Library Agent contributors",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "desktop": "node desktop/launch.js",
    "build:desktop-icon": "node scripts/build-desktop-icon.mjs",
    "package:desktop": "npm run build:desktop-icon && npm run build && electron-builder --win nsis",
    "build": "next build",
    "package:web": "npm run build && node scripts/package-web.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:performance": "vitest run tests/performance",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.1",
    "@prisma/client": "^6.2.0",
    "@xyflow/react": "^12.4.0",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.wormhole.libraryagent",
    "productName": "Wormhole Library Agent",
    "directories": {
      "output": "dist/desktop"
    },
    "npmRebuild": false,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server"
      },
      {
        "from": ".next/static",
        "to": "app-server/.next/static"
      },
      {
        "from": "prisma",
        "to": "app-server/prisma",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules/.prisma",
        "to": "app-server/node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "desktop/assets/icon.ico",
      "uninstallerIcon": "desktop/assets/icon.ico",
      "installerHeaderIcon": "desktop/assets/icon.ico",
      "shortcutName": "Wormhole Library Agent"
    }
  }
}
